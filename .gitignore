# ---- secrets & local env (never commit) ----
.env
.env.*
*.local
*.pem
*.key
*.token
secrets/

# ---- editor / dev-tool configs (keep dev setup out of history) ----
.vscode/
.idea/
.cursor/
.zcode/
.claude/
.agents/
.trae/
.windsurf/
.codex/
.qoder/
.kiro/
.video_agent/

# ---- internal notes (private docs stay out of the repo) ----
notes/
NOTES*.md
TODO*.md
*.internal.md
*NOTES*.md
DEPLOY*.md

# ---- python ----
__pycache__/
*.py[cod]
.venv/

# ---- node ----
node_modules/
web/node_modules/
web/dist/

# ---- runtime data & dataset assets ----
# Dataset assets come from GitHub Releases via scripts/fetch_dataset.py
.oip/
db/*.db
db/*.db-wal
db/*.db-shm
db/*.lock
db/prompts.db.gz
images/

# ---- logs & OS files ----
*.log
*.tmp
.DS_Store
Thumbs.db
Desktop.ini

# ── 2026-10-27 统一范式补全（与 techdou 仓 .gitignore 标准对齐）──

# ── 私密信息与密钥：绝不入库 ──
*.p12
*.pfx
secrets*
credentials*
_htpasswd


# ── 开发软件配置目录：本地工具状态不上传 ──
.claude.json
.gemini/
.roo/
.aider*
continue/
.aws/
.ssh/


# ── 内部文档与开发状态：不入版本控制，避免泄漏 ──
# README.md / CHANGELOG.md / SKILL.md / references/ / evals/ 是仓库正式内容，保持跟踪
drafts/
private/
internal/
dev/
dev-notes/
.archive/
.research/
*.draft.md
*.local.md
*.wip.md
DEVLOG.md
TODO.md
STATUS.md


# ── Python 运行产物 ──
venv/


# ── Node 前端产物 ──
dist/
build/
.next/
.nuxt/
*.tsbuildinfo


# ── 系统与临时文件 ──
desktop.ini
*~
